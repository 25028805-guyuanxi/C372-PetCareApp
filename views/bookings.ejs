<!DOCTYPE html><html><head><title>Bookings</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><%- include('partials/navbar') %><main class="container mt-4"><h2>My Bookings</h2><% messages.forEach(message => { %><div class="alert alert-success"><%= message %></div><% }) %><table class="table"><thead><tr><th>Pet</th><th>Service</th><th>Date</th><th>Price</th><th>Booking</th><th>Payment</th></tr></thead><tbody><% bookings.forEach(booking => { %><tr><td><%= booking.pet_name %></td><td><%= booking.service_name %></td><td><%= booking.booking_date.toISOString().slice(0,10) %></td><td>$<%= booking.booked_price %></td><td><%= booking.booking_status %></td><td><%= booking.payment_status %></td></tr><% }) %></tbody></table></main></body></html>
