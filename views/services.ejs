<!DOCTYPE html><html><head><title>Services</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><%- include('partials/navbar') %><main class="container mt-4"><h2>Book a Service</h2><% errors.forEach(error => { %><div class="alert alert-danger"><%= error %></div><% }) %><form action="/services/book" method="POST"><div class="mb-3"><label>Pet</label><select name="pet_id" class="form-select" required><option value="">Select pet</option><% pets.forEach(pet => { %><option value="<%= pet.id %>"><%= pet.name %></option><% }) %></select></div><div class="mb-3"><label>Service</label><select name="service_id" class="form-select" required><option value="">Select service</option><% services.forEach(service => { %><option value="<%= service.id %>"><%= service.name %> — $<%= service.price %></option><% }) %></select></div><div class="mb-3"><label>Date</label><input type="date" name="booking_date" class="form-control" required></div><button class="btn btn-primary">Create booking</button></form></main></body></html>
